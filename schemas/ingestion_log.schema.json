{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/song-dna-system/ingestion_log.schema.json",
  "title": "IngestionLog",
  "type": "object",
  "required": [
    "started_at",
    "query_or_topic",
    "requested_depth",
    "archive_checked",
    "candidates_found",
    "new_records_saved",
    "duplicates_skipped",
    "low_confidence_skipped",
    "errors",
    "notes"
  ],
  "properties": {
    "started_at": { "type": "string" },
    "query_or_topic": { "type": "string" },
    "requested_depth": {
      "type": "string",
      "enum": [
        "source_only",
        "dna_only",
        "song_brief",
        "song_pack",
        "visual_pack",
        "narration_pack",
        "full_production",
        "archive_reuse"
      ]
    },
    "archive_checked": { "type": "boolean" },
    "candidates_found": { "type": "integer", "minimum": 0 },
    "new_records_saved": { "type": "integer", "minimum": 0 },
    "duplicates_skipped": { "type": "integer", "minimum": 0 },
    "low_confidence_skipped": { "type": "integer", "minimum": 0 },
    "errors": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
