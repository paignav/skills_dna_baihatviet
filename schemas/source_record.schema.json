{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/song-dna-system/source_record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "required": [
    "id",
    "source_type",
    "canonical_title",
    "original_title",
    "aliases",
    "creators",
    "language",
    "confidence",
    "creative_dna",
    "do_not_copy",
    "requested_depth",
    "stage",
    "available_blocks",
    "missing_blocks",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": [
        "song",
        "soundtrack_cue",
        "film_theme",
        "poem",
        "literary_excerpt",
        "novel",
        "short_story",
        "folklore",
        "myth",
        "legend",
        "historical_anecdote",
        "theatrical_scene",
        "visual_artwork",
        "cultural_object"
      ]
    },
    "canonical_title": { "type": "string" },
    "original_title": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "creators": { "type": "array", "items": { "type": "string" } },
    "year": { "type": ["string", "null"] },
    "language": { "type": "string" },
    "country_or_region": { "type": ["string", "null"] },
    "source_urls": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "origin_context": { "type": ["string", "null"] },
    "creative_dna": {
      "type": "object",
      "required": [
        "emotional_engine",
        "narrative_pressure",
        "speaker_position",
        "hook_promise",
        "sonic_or_style_signature",
        "memory_images",
        "audience_use"
      ],
      "properties": {
        "emotional_engine": { "type": "string" },
        "narrative_pressure": { "type": "string" },
        "speaker_position": { "type": "string" },
        "hook_promise": { "type": "string" },
        "sonic_or_style_signature": { "type": "string" },
        "memory_images": { "type": "array", "items": { "type": "string" } },
        "audience_use": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "do_not_copy": { "type": "array", "items": { "type": "string" } },
    "new_song_angles": { "type": "array", "items": { "type": "string" } },
    "visual_anchors": { "type": "array", "items": { "type": "string" } },
    "reuse_ideas": { "type": "array", "items": { "type": "string" } },
    "requested_depth": {
      "type": "string",
      "enum": [
        "source_only",
        "dna_only",
        "song_brief",
        "song_pack",
        "visual_pack",
        "narration_pack",
        "full_production",
        "archive_reuse"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "source_found",
        "dna_extracted",
        "song_brief_created",
        "lyric_draft_created",
        "music_prompt_created",
        "visual_pack_created",
        "narration_pack_created",
        "ready_to_produce",
        "published_or_archived"
      ]
    },
    "available_blocks": { "type": "array", "items": { "type": "string" } },
    "missing_blocks": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["new", "used", "remixed", "archived"] },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
